# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Ключ Anthropic API (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# --- Необязательные настройки ---

# Язык саммари: ru | en
SUMMARY_LANG=ru

# Модель. По умолчанию claude-opus-5.
# Для экономии можно claude-sonnet-5 — качество тезисов чуть ниже.
ANTHROPIC_MODEL=claude-opus-5

# Глубина рассуждений: low | medium | high | xhigh | max
EFFORT=high

# Кто может пользоваться ботом: список Telegram user_id через запятую.
# Пусто = доступ всем (для личного бота лучше указать свой id).
ALLOWED_USER_IDS=

# Куда складывать базу с транскриптами
DB_PATH=vidsum.db

# Распознавание речи, когда у видео нет субтитров: off | faster-whisper
# Пакет уже в образе, включается только этой строкой.
ASR_BACKEND=off

# tiny | base | small | medium — чем больше, тем точнее и медленнее.
# base — разумный компромисс для сервера на 1-2 ядра.
WHISPER_MODEL=base
WHISPER_COMPUTE_TYPE=int8

# Потолок длины видео для распознавания, в секундах (5400 = 1.5 часа).
# Распознавание идёт медленнее реального времени: без потолка одно длинное
# видео заняло бы бота на часы.
ASR_MAX_DURATION=5400

# --- Только для запуска на сервере ---

# YouTube с серверных IP часто требует подтвердить, что вы не бот.
# Путь к файлу cookies в формате Netscape. Как получить — в DEPLOY.md.
COOKIES_FILE=

# Прокси для yt-dlp, если cookies не помогли или сервер в неудобной стране.
# Формат: http://user:pass@host:port или socks5://host:port
YTDLP_PROXY=
